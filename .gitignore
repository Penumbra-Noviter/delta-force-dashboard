# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.Python
*.so

# ── Testing ─────────────────────────────────────────
# pytest 缓存（pytest 自带 .gitignore 自忽略，此处显式声明更稳定可移植）
.pytest_cache/

# Playwright MCP 运行时数据（设计阶段产物，非项目代码）
.playwright-mcp/

# ── Virtual environments ───────────────────────────
venv/
.venv/
env/

# ── PyInstaller ─────────────────────────────────────
build/
dist/
*.manifest

# ── Data backups ────────────────────────────────────
*.bak
*.bak.*
*.tmp

# ── Runtime data ────────────────────────────────────
data.json
# 运行态设置（窗口几何/主题/置顶），O-18 起与 data.json 一致不入库
# 限定根目录，避免误吞子目录（如 .claude/settings.json）
/settings.json

# ── IDE / Editor ────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Agent tooling (local memory, not project code) ─
.serena/
.claude/

# ── OS ──────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Environment / Secrets ───────────────────────────
.env
.env.*

# Build outputs
Delta Force Dashboard.exe

# 架构评审陈旧产物（报告输出至 D:\Desktop\To-do，仓库内不入库）
python-arch-review-*.html

# Runtime log (O-01: profit_calculator.log 文件日志)
profit_calculator.log
